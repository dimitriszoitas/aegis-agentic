{
  "schemaVersion": 2,
  "product": "forma",
  "revision": 3,
  "scope": "src/product",
  "route": "?view=product",
  "mode": {
    "default": "dark",
    "supported": ["dark", "light"]
  },
  "pages": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "source": "src/product/dashboard.tsx",
      "patterns": ["pageHeader"]
    },
    {
      "id": "users",
      "title": "Users",
      "source": "src/product/users.tsx",
      "collection": "grid",
      "patterns": ["pageHeader", "collectionFilters", "dataGrid"]
    },
    {
      "id": "products",
      "title": "Products",
      "source": "src/product/products.tsx",
      "collection": "cards",
      "patterns": ["pageHeader", "collectionFilters"]
    },
    {
      "id": "invoices",
      "title": "Invoices",
      "source": "src/product/invoices.tsx",
      "collection": "grid",
      "patterns": ["pageHeader", "collectionFilters", "dataGrid"]
    },
    {
      "id": "settings",
      "title": "Settings",
      "source": "src/product/settings.tsx",
      "patterns": ["pageHeader"]
    }
  ],
  "patterns": {
    "pageHeader": {
      "export": "PageHeader",
      "module": "@/patterns/page-header",
      "invariants": [
        "One page title and description",
        "Shared shell owns page padding",
        "Actions use the actions slot",
        "No page-header eyebrows"
      ],
      "allowedVariations": [
        "Title and description content",
        "Relevant primary and secondary actions"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "forbiddenLocalTags": ["h1"]
    },
    "collectionFilters": {
      "export": "FormaFilterToolbar",
      "module": "./filter-toolbar",
      "source": "src/product/filter-toolbar.tsx",
      "desktopSearchWidthToken": "--group-application-business-app-size-width-wide-panel-vast",
      "mobileSearchWidth": "available-content-width",
      "invariants": [
        "Search first, then one Filters trigger with active count and result count",
        "The shared wrapper opens a SideSheet with canonical FilterOptions and AppliedFilterGroups",
        "Immediate filtering: OR within a facet and AND across facets and search",
        "Close, Show results and Escape preserve applied values and restore trigger focus",
        "Clear all resets search and all facets; removable summaries clear only their category",
        "One shared search width at each breakpoint",
        "Filters sit before the collection"
      ],
      "allowedVariations": [
        "Filter fields required by the domain",
        "Users role/status, Products category/status and Invoices status facets",
        "The dashboard recent-invoices table is a read-only summary linking to the full Invoices collection; its filtering lives there"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "requiredProps": ["query", "onClearQuery", "facets", "resultCount", "noun", "onClearAll"]
    },
    "dataGrid": {
      "export": "DataGrid",
      "module": "@/components/data-grid",
      "invariants": [
        "Use default column and density controls",
        "Honor workspace density",
        "Use pagination",
        "Selected count and clear-selection action",
        "Row details use SideSheet"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "requiredProps": ["density"],
      "forbiddenProps": ["renderToolbar"]
    },
    "forms": {
      "invariants": [
        "Field owns labels and errors",
        "New records use Modal",
        "Validate before saving",
        "Primary submit and secondary cancel actions",
        "Return focus on dismissal"
      ]
    }
  },
  "exceptions": [],
  "checks": ["npm run product:patterns", "npm run product:browser"],
  "changePolicy": "Reuse these product-local patterns. Record a justified variant here when the task requires it and update affected pages and checks together. This policy does not promote a pattern into the shared Aegis registry.",
  "routeInventory": {
    "source": "src/product/forma-app.tsx",
    "variable": "pages",
    "idProperty": "id"
  }
}
