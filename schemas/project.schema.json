{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/project.schema.json",
  "title": "Aegis local infrastructure project, version 1",
  "description": "Structural schema. The service additionally validates canonical timestamps, SHA-256 source identity, exact release pins, kit integrity and generated profile binding. Editing hashes is not an approval workflow. This local manifest is not an authenticated signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "pin",
    "kitDigest",
    "profileSha256",
    "releaseSha256",
    "telemetryEnabled",
    "ai"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "releaseId",
        "kitVersion",
        "registryRevision"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kitVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "registryRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "kitDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "telemetryEnabled": {
      "type": "boolean"
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowRemote",
        "model",
        "dailyRequestLimit"
      ],
      "properties": {
        "allowRemote": {
          "type": "boolean"
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:-]{1,128}$"
            }
          ]
        },
        "dailyRequestLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
