{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/component-contract.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["candidate", "source-backed-baseline"]
    },
    "verification": {
      "const": "not-certified-by-this-contract"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "anatomy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tokenGroup": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "behaviorProvider": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "verification",
    "purpose",
    "anatomy",
    "states",
    "invariants",
    "tokenGroup",
    "behaviorProvider"
  ],
  "additionalProperties": false
}
