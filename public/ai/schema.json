            "type": "string"
          },
          "uniqueItems": true
        },
        "default": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "additionalProperties": false
    },
    "guidance": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string"
        },
        "usage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
