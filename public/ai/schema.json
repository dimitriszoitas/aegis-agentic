        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "anatomy": {
          "type": "string"
        },
        "api": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        }
