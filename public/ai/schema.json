        "accessibility": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "intent": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
