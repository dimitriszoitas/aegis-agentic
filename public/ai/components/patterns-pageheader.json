    "tokens": "../../?path=/docs/patterns-page-structure-pageheader-overview--docs&docsTab=tokens"
  },
  "description": "A shared page-heading composition with optional breadcrumbs or a back destination, leading visual, metadata, actions, and content below. The default heading is h1; choose headingLevel to match the surrounding document. A back destination replaces breadcrumbs. Supply native links for navigation, buttons for actions, and the action component’s loading/disabled state for asynchronous work. On narrow screens, actions move below the title without changing keyboard order.",
  "exports": [
    "PageHeader"
  ],
  "importStatements": [
    "import { PageHeader } from '@dimitriszoitas/aegis-ui/patterns';"
  ],
