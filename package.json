{
  "name": "@dimitriszoitas/aegis-ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run tokens:check && npm run headless:check",
    "test": "vitest run src",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm docs:check && pnpm build-storybook",
    "test:stories": "node scripts/verify-stories.mjs",
    "test:docs": "node scripts/verify-documentation.mjs",
    "test:foundations": "node scripts/verify-foundation-docs.mjs",
    "build:package": "node scripts/build-package.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "docs:check": "node scripts/check-component-docs.mjs && node --test scripts/component-story-args.test.mjs && npm run ai:check",
    "prepack": "npm run build:package",
    "docs:generate": "node scripts/generate-component-docs.mjs && npm run ai:generate",
    "test:anatomy": "node scripts/verify-anatomy.mjs",
    "tokens:check": "node scripts/generate-token-hierarchy.mjs --check && node scripts/check-token-hierarchy.mjs && node --test scripts/check-token-hierarchy.test.mjs && node scripts/check-tokens.mjs && node scripts/check-component-css-tokens.mjs --self-test && node scripts/check-component-runtime-tokens.mjs",
    "ai:generate": "node scripts/generate-ai-contracts.mjs",
    "ai:check": "node scripts/generate-ai-contracts.mjs --check && node --test scripts/generate-ai-contracts.test.mjs",
    "headless:check": "node scripts/check-headless-boundary.mjs",
    "tokens:generate": "node scripts/generate-color-palettes.mjs && node scripts/generate-token-hierarchy.mjs"
  },
